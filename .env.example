# Copied to .env.local automatically the first time you run `npm run dev`
# (with a fresh random SEED_OWNER_PASSWORD). Never commit .env.local.

# Database. Local SQLite file by default.
# For Turso (when going online): DATABASE_URL=libsql://<your-db>.turso.io and DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:data/rental.db
DATABASE_AUTH_TOKEN=

# Load the sample houses/tenants when the database is empty. Set to false in production.
SEED_SAMPLE_DATA=true

# First owner login, created on first run if this email has no login yet.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=change-me

# Public address of the site once online (Messenger needs it to fetch the GCash QR image), e.g. https://5a-rentals.vercel.app
SITE_URL=

# Facebook Messenger (spec §10). Leave empty until the Meta app is set up; reminders then run as a dry run.
MESSENGER_PAGE_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_API_VERSION=v21.0

# Protects the daily reminder job (Vercel Cron sends it automatically when set in Vercel).
CRON_SECRET=
